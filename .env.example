[TEMPLATE]
# Telegram <-> Claude Code bridge — configuration template
# Copy this file to .env and fill in your values. Never commit your real .env.
#   Windows:  copy .env.example .env
#   Linux/mac: cp .env.example .env

# 1. REQUIRED — bot token from @BotFather (create your own bot, any name works)
TELEGRAM_BOT_TOKEN=

# 2. REQUIRED — comma-separated numeric Telegram user IDs allowed to use the bridge
#    (get yours from @userinfobot). The bridge REFUSES TO START without this,
#    because every job runs Claude with full access to this machine.
#    Example: ALLOWED_TELEGRAM_IDS=123456789
ALLOWED_TELEGRAM_IDS=

# 3. OPTIONAL — pin a proxy for Telegram traffic (e.g. socks5://127.0.0.1:10808 or http://127.0.0.1:8080).
#    Leave empty to auto-detect: HTTPS_PROXY/ALL_PROXY env vars -> Windows system proxy -> direct.
#    Local proxies (127.0.0.1, localhost) are fine — v2rayN & co listen locally.
TELEGRAM_PROXY_URL=

# 4. OPTIONAL — claude executable if not on PATH
# CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe

# 5. OPTIONAL — working directory for Claude jobs (defaults to the bridge folder)
# BRIDGE_CWD=C:\path\to\your\project

# 6. OPTIONAL — tuning (defaults shown)
# CLAUDE_TIMEOUT_MS=1800000        (per-job timeout, 5000..14400000)
# MAX_QUEUE_PER_CHAT=3             (max waiting jobs per chat, 1..100)
# MAX_STDOUT_BYTES=524288          (captured claude stdout per job, 1024..8388608)
# MAX_STDERR_BYTES=65536           (captured claude stderr per job, 1024..1048576)
# BRIDGE_DEBUG=0                   (1 = verbose debug logging)
