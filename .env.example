# Telegram <-> Claude Code bridge — configuration template
# Copy this file to .env and fill in your values. Never commit your real .env.
#   Windows:  copy .env.example .env
#   Linux/mac: cp .env.example .env

# 1. REQUIRED — bot token from @BotFather (create your own bot, any name works)
TELEGRAM_BOT_TOKEN=

# 2. REQUIRED — comma-separated numeric Telegram user IDs allowed to use the bridge
#    (get yours from @userinfobot). The bridge REFUSES TO START without this,
#    because every job runs Claude with full access to this machine.
#    Example: ALLOWED_TELEGRAM_IDS=123456789
ALLOWED_TELEGRAM_IDS=

# 3. OPTIONAL — pin a proxy for Telegram traffic (e.g. socks5://127.0.0.1:10808 or http://127.0.0.1:8080).
#    Leave empty to auto-detect: HTTPS_PROXY/ALL_PROXY env vars -> Windows system proxy -> direct.
#    Local proxies (127.0.0.1, localhost) are fine — v2rayN & co listen locally.
#    The standard HTTPS_PROXY / HTTP_PROXY / ALL_PROXY environment variables are
#    also honored (explicit TELEGRAM_PROXY_URL takes precedence).
TELEGRAM_PROXY_URL=

# 4. OPTIONAL — how to launch Claude. Accepted forms (never a shell; the
#    Telegram prompt is always a direct spawn argument):
#      - empty or bare name  -> resolved via PATH; must actually resolve
#      - native executable   -> e.g. C:\Users\you\.local\bin\claude.exe
#      - Windows .cmd/.bat   -> npm-style shims are parsed as node + cli.js
#                              (or a sibling .exe); unparseable shims refuse
#                              to start rather than guess
#      - JS CLI entrypoint   -> path to cli.js, launched via node
# CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe

# 5. OPTIONAL — working directory for Claude jobs (defaults to the bridge folder).
#    Must be an existing directory.
# BRIDGE_CWD=C:\path\to\your\project

# 6. OPTIONAL — directory for sessions.json / offset.txt (defaults to ./state
#    next to bridge.js). Created if missing.
# BRIDGE_STATE_DIR=C:\path\to\state

# 7. OPTIONAL — first-start Telegram backlog policy (default: false = safe).
#    false: on the very first start (no saved offset yet) messages that were
#           sent while offline are SKIPPED, never executed.
#    true:  opt in to consuming the backlog on first start.
#    Restarts always resume from the saved offset either way. First successful
#    initialization records state even when the backlog is empty, so a restart
#    is never mistaken for another first start. Corrupted/unreadable offset
#    state is NOT treated as a clean first start: the bridge refuses to start
#    instead of risking pending commands. If offset persistence fails, the
#    command is not executed (at-most-once delivery).
PROCESS_INITIAL_BACKLOG=false

# 8. OPTIONAL — tuning (defaults shown)
# CLAUDE_TIMEOUT_MS=1800000        (per-job timeout, 5000..14400000)
# MANAGED_TASK_TIMEOUT_MS=14400000 (managed-session task timeout, 10000..86400000)
# MAX_QUEUE_PER_CHAT=3             (max waiting jobs per chat, 1..100)
# MAX_STDOUT_BYTES=524288          (captured claude stdout per job, 1024..8388608)
# MAX_STDERR_BYTES=65536           (captured claude stderr per job, 1024..1048576)
# BRIDGE_DEBUG=0                   (1 = verbose debug logging)
